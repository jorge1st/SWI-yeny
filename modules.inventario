    def _create_card(self, title, value, bg_color, text_color, subtitle, border_color=None):
        """Crea una card de estadística reutilizable con colores vibrantes."""
        frame = QFrame()
        border = border_color if border_color else bg_color
        frame.setStyleSheet(f"""
            QFrame {{
                background: {bg_color};
                border-radius: 12px;
                border: 2px solid {border};
                padding: 12px;
            }}
        """)
        # Sombra sutil
        frame.setGraphicsEffect(None)
        
        layout = QVBoxLayout(frame)
        layout.setSpacing(6)

        title_lbl = QLabel(title)
        title_lbl.setStyleSheet(f"font-size: 11px; color: rgba(255,255,255,0.9); font-weight: 600;")
        
        value_lbl = QLabel(value)
        value_lbl.setStyleSheet(f"font-size: 20px; font-weight: 800; color: {text_color};")
        
        subtitle_lbl = QLabel(subtitle)
        subtitle_lbl.setStyleSheet("font-size: 10px; color: rgba(255,255,255,0.8);")

        layout.addWidget(title_lbl)
        layout.addWidget(value_lbl)
        layout.addWidget(subtitle_lbl)

        return {"frame": frame, "value_label": value_lbl}

    # ==================== MÉTODOS DE INTERACCIÓN ====================

    def _on_back(self):
        try:
            p = self.parent()
            while p is not None:
                if hasattr(p, "restore_dashboard_view") and callable(getattr(p, "restore_dashboard_view")):
                    p.restore_dashboard_view()
                    return
                p = p.parent()
        except Exception:
            pass

    def _use_stock_full(self):
        pid = self._current_selected_product_id()
        if pid is None:
            return
        prod = self._product_by_id(pid)
        if not prod:
            return
        try:
            stock = float(prod.get('stock') or 0.0)
            self.qty_input.setText(str(int(stock)) if stock == int(stock) else f"{stock:.2f}")
        except Exception:
            self.qty_input.setText("")

    def _on_product_change(self, idx):
        """Actualiza la vista previa cuando cambia el producto seleccionado."""
        pid = self._current_selected_product_id()
        
        # Limpiar resultado anterior
        self.result_frame.hide()
        
        if pid is None:
            return

    def _current_selected_product_id(self):
        try:
            data = self.product_cb.currentData()
            return int(data) if data is not None else None
        except Exception:
            return None

    def _product_by_id(self, pid):
        try:
            for p in self._products_list:
                if int(p.get('id')) == int(pid):
                    return p
        except Exception:
            pass
        return None

    def _on_calc_product_utility(self):
        """Calcula y muestra la utilidad de forma profesional con ambos valores."""
        pid = self._current_selected_product_id()
        if pid is None:
            QMessageBox.warning(self, "Calcular", "Seleccione un producto.")
            return
        
        prod = self._product_by_id(pid)
        if not prod:
            QMessageBox.warning(self, "Calcular", "Producto no encontrado.")
            return

        # Obtener cantidad
        qtxt = (self.qty_input.text() or "").strip()
        try:
            qty = float(qtxt) if qtxt != "" else float(prod.get('stock') or 0.0)
        except Exception:
            QMessageBox.warning(self, "Calcular", "Cantidad inválida.")
            return
        
        if qty <= 0:
            QMessageBox.warning(self, "Calcular", "Cantidad debe ser mayor a 0.")
            return

        # Precio override
        op_txt = (self.override_price_input.text() or "").strip()
        price_override_bs = None
        if op_txt != "":
            try:
                price_override_bs = D(op_txt)
            except Exception:
                QMessageBox.warning(self, "Calcular", "Precio override inválido.")
                return

        rate_dec, _ = get_current_bcv_rate_safe()

        # === CÁLCULO ===
        # Obtener precio USD base
        precio_usd_base = prod.get('precio_final')
        
        # Calcular precio de venta en Bs
        sell_with_iva_bs = None
        if price_override_bs is not None:
            sell_with_iva_bs = price_override_bs
        elif precio_usd_base and rate_dec:
            ref = calcular_precio_venta_actual(float(precio_usd_base), float(rate_dec))
            sell_with_iva_bs = ref.get('precio_bs_actual')

        if sell_with_iva_bs is None:
            QMessageBox.warning(self, "Calcular", 
                "No se puede calcular el precio. Verifique que haya tasa BCV configurada.")
            return

        # Calcular sin IVA
        try:
            iva_pct = D(prod.get('iva') or 0)
        except Exception:
            iva_pct = D('0')
            
        sell_sin_iva_bs = None
        if sell_with_iva_bs:
            denom = (Decimal('1') + (iva_pct / Decimal('100')))
            if denom != 0:
                sell_sin_iva_bs = (sell_with_iva_bs / denom).quantize(DEC_2, rounding=ROUND_HALF_UP)

        # Costo en Bs
        try:
            costo_usd = D(prod.get('costo_compra') if prod.get('costo_compra') not in (None, '') 
                         else prod.get('costo') or 0)
        except Exception:
            costo_usd = D('0')
            
        moneda = (prod.get('moneda') or '').strip().lower()
        if moneda in ('$', 'usd', 'dolar', 'dólar'):
            cost_bs = (costo_usd * rate_dec).quantize(DEC_2, rounding=ROUND_HALF_UP) if rate_dec else None
        else:
            cost_bs = costo_usd.quantize(DEC_2, rounding=ROUND_HALF_UP)

        if sell_sin_iva_bs is None or cost_bs is None:
            QMessageBox.warning(self, "Calcular", "Datos insuficientes para calcular utilidad.")
            return

        # Cálculos finales
        unit_profit = (sell_sin_iva_bs - cost_bs).quantize(DEC_2, rounding=ROUND_HALF_UP)
        total_profit = (unit_profit * D(str(qty))).quantize(DEC_2, rounding=ROUND_HALF_UP)
        
        # === CÁLCULO DE AMBOS MARGENES ===
        # Margen sobre venta (el tradicional)
        try:
            margin_pct = (unit_profit / sell_sin_iva_bs * 100) if sell_sin_iva_bs else 0
        except:
            margin_pct = 0
            
        # Ganancia sobre costo (mark-up) - NUEVO
        try:
            markup_pct = (unit_profit / cost_bs * 100) if cost_bs and cost_bs != 0 else 0
        except:
            markup_pct = 0

        # === MOSTRAR RESULTADO ===
        self.res_producto_lbl.setText(f"📦 Producto: <b>{prod.get('nombre') or prod.get('codigo')}</b>")
        self.res_cantidad_lbl.setText(f"📊 Cantidad: <b>{qty:,.2f}</b> unidades")
        
        self.res_precio_con_iva_lbl.setText(
            f"💰 Precio con IVA: <span style='color:#2D7A2D; font-weight:600;'>{format_bs_minimal(sell_with_iva_bs)}</span>")
        self.res_precio_sin_iva_lbl.setText(
            f"💵 Precio sin IVA: <span style='color:#555;'>{format_bs_minimal(sell_sin_iva_bs)}</span>")
        
        self.res_costo_lbl.setText(
            f"📉 Costo unitario: <span style='color:#C62828;'>{format_bs_minimal(cost_bs)}</span>")
        self.res_margen_lbl.setText(
            f"📈 Margen sobre venta: <span style='color:#1565C0; font-weight:600;'>{float(margin_pct):.1f}%</span>")
        
        self.res_util_unidad_lbl.setText(f"Utilidad/unidad: {format_bs_minimal(unit_profit)}")
        self.res_util_total_lbl.setText(f"UTILIDAD TOTAL: {format_bs_minimal(total_profit)}")
        
        # === NUEVO: MOSTRAR AMBOS VALORES EN LA SECCIÓN EXPLICATIVA ===
        self.res_markup_lbl.setText(
            f"<span style='color:#2E7D32;'>▲</span> Ganancia sobre costo: <b>{float(markup_pct):.1f}%</b>")
        self.res_margin_detailed_lbl.setText(
            f"<span style='color:#1565C0;'>●</span> Margen sobre venta: <b>{float(margin_pct):.1f}%</b>")
        
        self.result_frame.show()

    # ==================== REFRESH Y DATOS ====================

    def refresh(self):
        try:
            rate_dec, ts = get_current_bcv_rate_safe()
            rate_f = float(rate_dec) if rate_dec is not None else None
            self._last_known_rate = rate_dec

            prods = self.db.listar_productos() or []
            self._products_list = prods

            total_fisico = D('0')
            total_val_usd = D('0')
            total_val_bs_calc = D('0')
            utilidad_total_usd = D('0')
            per_product_profits = []
            count_products = 0
            count_usd_reg = 0
            count_bs_reg = 0
            count_no_iva = 0
            weighted_margin_numer = D('0')
            weighted_margin_denom = D('0')

            for p in prods:
                count_products += 1
                stock = D(str(p.get('stock') or 0))
                total_fisico += stock

                moneda_reg = (p.get('moneda') or '').strip().lower()
                if moneda_reg in ('$', 'usd', 'dolar', 'dólar'):
                    count_usd_reg += 1
                else:
                    count_bs_reg += 1

                iva_pct = D(str(p.get('iva') or 0))
                if iva_pct == 0:
                    count_no_iva += 1

                # Precio USD base
                precio_usd_con_iva = p.get('precio_final')
                if not precio_usd_con_iva:
                    continue
                
                try:
                    precio_usd_val = D(str(precio_usd_con_iva))
                except:
                    continue

                # Calcular Bs actual
                precio_bs_con_iva = None
                if rate_dec:
                    ref = calcular_precio_venta_actual(float(precio_usd_val), float(rate_dec))
                    if ref.get('precio_bs_actual'):
                        precio_bs_con_iva = D(str(ref.get('precio_bs_actual')))

                # Precio sin IVA
                denom_iva = (Decimal('1') + (iva_pct / Decimal('100')))
                precio_usd_sin_iva = (precio_usd_val / denom_iva).quantize(DEC_USD, rounding=ROUND_HALF_UP) if denom_iva != 0 else D('0')

                # Totales
                total_val_usd += (precio_usd_val * stock)
                if precio_bs_con_iva:
                    total_val_bs_calc += (precio_bs_con_iva * stock)

                # Costo y utilidad USD
                try:
                    costo_usd_val = D(str(p.get('costo_compra') if p.get('costo_compra') not in (None, '') 
                                         else p.get('costo') or 0))
                except:
                    costo_usd_val = D('0')

                unit_profit_usd = (precio_usd_sin_iva - costo_usd_val).quantize(DEC_USD, rounding=ROUND_HALF_UP)
                total_profit_usd = (unit_profit_usd * stock).quantize(DEC_USD, rounding=ROUND_HALF_UP)
                utilidad_total_usd += total_profit_usd

                per_product_profits.append({
                    'id': p.get('id'),
                    'codigo': p.get('codigo'),
                    'nombre': p.get('nombre'),
                    'stock': float(stock),
                    'unit_profit_usd': float(unit_profit_usd),
                    'total_profit_usd': float(total_profit_usd),
                    'sell_usd': float(precio_usd_val),
                    'iva': float(iva_pct)
                })

                # Margen
                try:
                    margin_pct = (unit_profit_usd / precio_usd_sin_iva * 100) if precio_usd_sin_iva else 0
                except:
                    margin_pct = 0
                weighted_margin_numer += (stock * precio_usd_sin_iva * D(str(margin_pct)))
                weighted_margin_denom += (stock * precio_usd_sin_iva)

            avg_margin_pct = D('0')
            try:
                if weighted_margin_denom and weighted_margin_denom != 0:
                    avg_margin_pct = (weighted_margin_numer / weighted_margin_denom).quantize(DEC_2, rounding=ROUND_HALF_UP)
            except:
                pass

            per_product_profits.sort(key=lambda x: x.get('total_profit_usd', 0), reverse=True)
            top5 = per_product_profits[:5]

            # Actualizar UI
            self.tf_val.setText(f"{int(total_fisico):,}")
            self.val_usd_lbl.setText(f"{float(total_val_usd):,.4f} $")
            self.val_bs_lbl.setText(f"{float(total_val_bs_calc):,.2f} Bs" if total_val_bs_calc else "-- Bs")
            self.util_amount_lbl.setText(f"{float(utilidad_total_usd):,.4f} $")

            # Stats
            self.lbl_count_products.setText(f"📦 {count_products}")
            self.lbl_no_iva.setText(f"⚠️ {count_no_iva}")
            self.lbl_by_usd.setText(f"💵 {count_usd_reg}")
            self.lbl_by_bs.setText(f"💴 {count_bs_reg}")
            self.lbl_tasa.setText(f"📈 {rate_f:,.2f}" if rate_f else "📈 N/D")
            self.lbl_avg_margin.setText(f"📊 {float(avg_margin_pct):.1f}%")

            # Combo productos
            self.product_cb.blockSignals(True)
            self.product_cb.clear()
            for p in self._products_list:
                name = f"{p.get('nombre') or ''} ({p.get('codigo') or ''})"
                self.product_cb.addItem(name, p.get('id'))
            self.product_cb.blockSignals(False)

            # Tabla top 5
            self.top_table.setRowCount(0)
            for p in top5:
                row = self.top_table.rowCount()
                self.top_table.insertRow(row)
                self.top_table.setItem(row, 0, QTableWidgetItem(str(p.get('id') or '')))
                self.top_table.setItem(row, 1, QTableWidgetItem(str(p.get('codigo') or '')))
                self.top_table.setItem(row, 2, QTableWidgetItem(str(p.get('nombre') or '')[:30]))
                self.top_table.setItem(row, 3, QTableWidgetItem(f"{p.get('stock'):,.0f}"))
                self.top_table.setItem(row, 4, QTableWidgetItem("Sí" if p.get('iva') else "No"))
                item = QTableWidgetItem(f"{p.get('total_profit_usd'):,.4f} $")
                item.setTextAlignment(Qt.AlignRight)
                self.top_table.setItem(row, 5, item)

        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error al calcular inventario: {str(e)}")

    def _on_export(self):
        # Implementación de exportación (mantener existente o simplificar)
        pass
