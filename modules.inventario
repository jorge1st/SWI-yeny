# modules/inventario.py
from PyQt5.QtWidgets import (
    QWidget, QVBoxLayout, QHBoxLayout, QLabel, QPushButton, QFrame,
    QTableWidget, QTableWidgetItem, QFileDialog,
    QMessageBox, QComboBox, QLineEdit, QFormLayout, QSizePolicy,
    QGridLayout, QGroupBox, QTextEdit, QScrollArea
)
from PyQt5.QtCore import Qt, QTimer
from PyQt5.QtGui import QFont
from decimal import Decimal, ROUND_HALF_UP, getcontext
from typing import List, Dict, Any, Optional
import os
import csv

from modules.pricing import calcular_precio_venta_actual, format_usd_minimal, format_bs_minimal

getcontext().prec = 28
DEC_2 = Decimal("0.01")
DEC_USD = Decimal("0.0001")


def D(v) -> Decimal:
    try:
        return Decimal(str(v))
    except Exception:
        return Decimal('0')


def get_current_bcv_rate_safe():
    try:
        from main import get_current_bcv_rate
        r, ts = get_current_bcv_rate()
        return (D(r), ts) if r is not None else (None, ts)
    except Exception:
        return (None, None)


class InventoryViewWidget(QWidget):
    """
    Resumen de inventario con USD como moneda base permanente.
    Diseño profesional con información claramente organizada.
    """
    RATE_POLL_MS = 5000

    def __init__(self, db, parent=None):
        super().__init__(parent)
        self.db = db
        self._inv_cached: Dict[str, Any] = {}
        self._products_list: List[Dict[str, Any]] = []
        self._last_known_rate: Optional[Decimal] = None
        self._build_ui()

        # Poll BCV rate
        self._rate_poll_timer = QTimer(self)
        self._rate_poll_timer.setInterval(self.RATE_POLL_MS)
        self._rate_poll_timer.timeout.connect(self._check_rate_change)
        self._rate_poll_timer.start()

        QTimer.singleShot(0, self.refresh)

    def closeEvent(self, ev):
        try:
            if hasattr(self, "_rate_poll_timer") and self._rate_poll_timer:
                self._rate_poll_timer.stop()
        except Exception:
            pass
        super().closeEvent(ev)

    def _check_rate_change(self):
        try:
            rate_dec, _ = get_current_bcv_rate_safe()
            if (rate_dec is None and self._last_known_rate is not None) or \
               (rate_dec is not None and self._last_known_rate is not None and rate_dec != self._last_known_rate):
                self._last_known_rate = rate_dec
                if self.isVisible():
                    self.refresh()
        except Exception:
            pass

